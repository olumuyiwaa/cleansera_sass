# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
# Base domain for the host-resolved public booking widget — a business's
# widget is reachable at <subdomain>.WIDGET_BASE_DOMAIN, or their own
# customDomain if they've set one. Used by resolveBusinessFromHost; the
# slug-resolved widget (/widget-embed/:subdomain) works without this set.
WIDGET_BASE_DOMAIN=localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cleansera

# Redis
REDIS_URL=redis://localhost:6379

NOTIFICATION_QUEUE=true

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@cleansera.nl

# SMS / OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push (cleaner app). Either the JSON blob, or the three values below it.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# File storage (DigitalOcean Spaces / S3-compatible)
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=cleansera-uploads
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Optional — set if Spaces sits behind a CDN so public branding asset URLs
# (logo, site hero image, gallery) use the CDN host instead of the raw
# Spaces endpoint. Leave unset to use the default Spaces public URL.
DO_SPACES_CDN_ENDPOINT=

# Subscription billing (CleanSera -> Business only)
STRIPE_SECRET_KEY=
# Stripe signs each webhook ENDPOINT with its own secret. You need two endpoints
# pointing at /api/v1/webhooks/stripe: one for "Account" events (subscription
# billing) and one for "Connected accounts" events (job payments, disputes,
# account.updated). List both secrets, comma separated.
STRIPE_WEBHOOK_SECRETS=
# Legacy single secret, still honoured.
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Stripe Connect (job-level customer payments — separate from the platform
# subscription billing above). Basis points platform keeps per paid booking;
# 150 = 1.5%.
#
# MUST stay 0 by default: the pricing page FAQ promises businesses "never a
# percentage of what your customers pay you" / "the money never routes
# through us." Any non-zero value here directly contradicts that promise the
# moment a business connects Stripe and takes a card payment. If the
# business model changes to include a take-rate on job payments, update the
# pricing page copy in cleansera_sass_website FIRST, then raise this.
PLATFORM_APPLICATION_FEE_BPS=0
APP_URL=http://localhost:3000

# Behind a reverse proxy / load balancer: number of proxy hops to trust so
# rate limiting sees real client IPs. Defaults to 1 in production.
TRUST_PROXY=1
# Interactive API docs are disabled in production unless this is true.
ENABLE_API_DOCS=false

# Subscription checkout (Stripe Checkout, CleanSera -> Business)
SUBSCRIPTION_TRIAL_DAYS=14
# Access rules. Enforcement defaults to ON in production and OFF elsewhere.
# Without a subscription a business gets a platform trial (SUBSCRIPTION_TRIAL_DAYS
# from creation) on the cheapest plan's limits; a lapsed business is read-only.
SUBSCRIPTION_ENFORCEMENT=
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=7
# Recurring visits are generated this many days ahead.
RECURRING_LOOKAHEAD_DAYS=21
# Set true to have Stripe Tax add BTW/VAT to the platform's own invoices.
STRIPE_AUTOMATIC_TAX=false

# Job payments. iDEAL must also be enabled in the platform's Stripe
# payment-method settings; it only works for EUR.
# Leave empty to use Stripe's dynamic payment methods (iDEAL appears for EUR when
# enabled on the connected account). Set e.g. "card,ideal" to force a fixed list.
CHECKOUT_PAYMENT_METHODS=
# Job payments are DIRECT charges on the business's own Stripe account: the
# business is merchant of record and pays Stripe's fees; CleanSera holds no funds.
# Minutes an unpaid deposit holds its slot (30-1440).
DEPOSIT_HOLD_MINUTES=60
# Cleaner payouts via Stripe Transfers are unverified with direct charges; keep
# off and use manual "mark as paid" until proven in test mode.
ENABLE_STRIPE_CLEANER_PAYOUTS=false
# ISO country of connected accounts (e.g. NL). Unset = the platform's country.
PLATFORM_COUNTRY=NL

# Customer portal one-time-code sessions
PORTAL_TOKEN_EXPIRY=24h

# Geocoding / service areas
GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=

# Default currency (ISO 4217) for new businesses and any payment that does not
# carry its own. Each business can set its own (Business.currency).
DEFAULT_CURRENCY=eur
# Locale for dates/amounts in customer messages.
DEFAULT_LOCALE=nl-NL

# --- Public booking widget abuse controls ---
# Cloudflare Turnstile secret. When set, POST /widget/.../bookings and /waitlist
# require a valid captchaToken (the widget must render the Turnstile challenge).
TURNSTILE_SECRET_KEY=
# Max bookings one phone/email may create through the public form per 24 h.
WIDGET_MAX_BOOKINGS_PER_CUSTOMER_PER_DAY=5

# --- BTW / invoicing ---
# Prices are VAT-inclusive. Platform default when a business/service has no rate (basis points, 2100 = 21%).
DEFAULT_VAT_RATE_BPS=2100
