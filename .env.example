# App
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
WIDGET_BASE_DOMAIN=cleansera.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cleansera

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@cleansera.com

# SMS / OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (cleaner app)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# File storage (DigitalOcean Spaces / S3-compatible)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=cleansera-uploads
DO_SPACES_KEY=
DO_SPACES_SECRET=

# Subscription billing (CleanSera -> Business only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Geocoding / service areas
GOOGLE_MAPS_API_KEY=
