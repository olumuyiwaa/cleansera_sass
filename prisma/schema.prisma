generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum GlobalRole {
  SUPER_ADMIN
  PLATFORM_USER // any business-linked or customer user; specific role lives on BusinessMember/CleanerProfile/Customer
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?    @unique
  passwordHash     String
  firstName        String
  lastName         String
  globalRole       GlobalRole @default(PLATFORM_USER)
  isEmailVerified  Boolean    @default(false)
  isActive         Boolean    @default(true)
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  avatarKey        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions            Session[]
  passwordResets      PasswordReset[]
  otpCodes            OtpCode[]
  businessMemberships BusinessMember[]
  cleanerProfiles     CleanerProfile[]
  auditLogs           AuditLog[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  // The business workspace this session was issued for. A user with
  // affiliations to more than one business (e.g. a cleaner working for two
  // companies) can hold concurrent sessions in different workspaces; refresh
  // keeps you in the same one instead of re-resolving to "whichever
  // affiliation happens to come back first".
  businessId   String?
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    String // EMAIL_VERIFY | LOGIN_2FA | PHONE_VERIFY
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ============================================================
// BUSINESS (TENANT)
// ============================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Business {
  id           String   @id @default(cuid())
  name         String
  subdomain    String   @unique
  customDomain String?  @unique
  timezone     String   @default("Europe/Natherlands")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Franchise / multi-location support. Each location is still a full,
  // independently-scoped tenant (its own cleaners, customers, bookings,
  // widget subdomain) — nothing about the isolation model above changes.
  // parentBusinessId only adds a rollup: an ORG_ADMIN member of the parent
  // can view aggregated reporting and switch between its locations.
  parentBusinessId String?
  parentBusiness    Business?  @relation("BusinessLocations", fields: [parentBusinessId], references: [id], onDelete: SetNull)
  locations         Business[] @relation("BusinessLocations")

  // Stripe Connect — required before this business can accept job-level
  // customer payments through CleanSera. Money for a paid booking is
  // transferred to this connected account (minus the platform fee), never
  // held in CleanSera's own Stripe balance. Subscription billing
  // (BusinessSubscription below) is unrelated and unaffected by this.
  stripeConnectedAccountId String? @unique
  stripeConnectOnboarded   Boolean @default(false)
  stripeChargesEnabled     Boolean @default(false)
  stripePayoutsEnabled     Boolean @default(false)

  branding           BusinessBranding?
  addresses          BusinessAddress[]
  serviceAreas       ServiceArea[]
  hours              BusinessHours[]
  members            BusinessMember[]
  cleaners           CleanerProfile[]
  customers          Customer[]
  services           Service[]
  bookings           Booking[]
  recurringSchedules RecurringSchedule[]
  reviews            Review[]
  conversations      Conversation[]
  notifications      Notification[]
  subscription       BusinessSubscription?
  pricing            BusinessPricing?
  coupons            Coupon[]
  auditLogs          AuditLog[]
  ChecklistTemplate  ChecklistTemplate[]
  supportTickets     SupportTicket[]
  cleanerDocuments   CleanerDocument[]

  @@index([subdomain])
  @@index([parentBusinessId])
}

model BusinessBranding {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logoKey            String?
  primaryColor       String?
  accentColor        String?
  tagline            String?
  widgetEmbedEnabled Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model BusinessAddress {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("NG")
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model ServiceArea {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  centerLat    Float
  centerLng    Float
  radiusMeters Int
  createdAt    DateTime @default(now())

  @@index([businessId])
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday .. 6 = Saturday
  openTime   String // "08:00"
  closeTime  String // "18:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

// Business pricing settings: frequency discounts and coupons
model BusinessPricing {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  frequencyDiscounts Json? // { WEEKLY: 0.1, BIWEEKLY: 0.05 }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Coupon {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code               String
  type               String // PERCENT | AMOUNT
  value              Int // percent (0-100) or cents
  isActive           Boolean   @default(true)
  appliesToServiceId String?
  expiresAt          DateTime?
  maxRedemptions     Int?
  perCustomerLimit   Int?
  redeemedCount      Int?      @default(0)
  bookings           Booking[]
  createdAt          DateTime  @default(now())

  @@unique([businessId, code])
  @@index([businessId])
}

enum BusinessMemberRole {
  BUSINESS_OWNER
  BUSINESS_MANAGER
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole
  isActive   Boolean            @default(true)
  invitedAt  DateTime           @default(now())
  joinedAt   DateTime?

  @@unique([businessId, userId])
  @@index([businessId])
}

// ============================================================
// SUBSCRIPTIONS (CleanSera -> Business billing only)
// ============================================================

model SubscriptionPlan {
  id                String  @id @default(cuid())
  name              String  @unique // Starter | Growth | Pro
  stripePriceId     String  @unique
  maxCleaners       Int?
  monthlyPriceCents Int
  features          Json?
  isActive          Boolean @default(true)

  subscriptions BusinessSubscription[]
}

model BusinessSubscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  invoices PlatformInvoice[]
}

model PlatformInvoice {
  id              String               @id @default(cuid())
  subscriptionId  String
  subscription    BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeInvoiceId String               @unique
  amountCents     Int
  status          String // paid | open | void | uncollectible
  issuedAt        DateTime
  paidAt          DateTime?

  @@index([subscriptionId])
}

// ============================================================
// STAFF (CLEANERS) — onboarded/offboarded by their business
// ============================================================

enum CleanerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

model CleanerProfile {
  id               String        @id @default(cuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           CleanerStatus @default(PENDING)
  hireDate         DateTime?
  offboardedAt     DateTime?
  offboardedReason String?
  serviceAreaIds   String[] // ServiceArea ids this cleaner covers

  // Best-known live position, updated on clock-in/clock-out. Used by
  // dispatch for real proximity ranking instead of inferring location from
  // wherever the cleaner's last completed job happened to be.
  lastKnownLat Float?
  lastKnownLng Float?
  lastKnownAt  DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  availability CleanerAvailability[]
  assignments  BookingAssignment[]
  documents    CleanerDocument[]
  reviews      Review[]

  // One profile per person per business — not per person globally. A
  // cleaner offboarded by Business A can be onboarded fresh by Business B
  // (or re-onboarded by A) without an email collision.
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([userId])
}

model CleanerAvailability {
  id        String         @id @default(cuid())
  cleanerId String
  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([cleanerId])
}

// ============================================================
// CUSTOMERS (business-scoped CRM — separate record per business)
// ============================================================

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String?
  phone      String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  addresses          CustomerAddress[]
  bookings           Booking[]
  recurringSchedules RecurringSchedule[]
  reviews            Review[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)

  recurringSchedules RecurringSchedule[]

  @@index([customerId])
}

// ============================================================
// CATALOG
// ============================================================

enum PricingModel {
  FLAT
  PER_SQFT
  PER_ROOM
  HOURLY
}

model Service {
  id               String       @id @default(cuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String // Standard Clean, Deep Clean, Move-Out Clean, etc.
  description      String?
  pricingModel     PricingModel @default(FLAT)
  basePriceCents   Int
  estimatedMinutes Int
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  addOns             ServiceAddOn[]
  bookings           Booking[]
  recurringSchedules RecurringSchedule[]

  @@index([businessId])
}

model ServiceAddOn {
  id           String  @id @default(cuid())
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String // e.g. "Inside fridge", "Inside oven", "Windows"
  priceCents   Int
  extraMinutes Int     @default(0)

  @@index([serviceId])
}

// ============================================================
// BOOKINGS
// ============================================================

enum BookingStatus {
  REQUESTED
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringSchedule {
  id                String              @id @default(cuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service             @relation(fields: [serviceId], references: [id])
  customerAddressId String?
  customerAddress   CustomerAddress?    @relation(fields: [customerAddressId], references: [id])
  frequency         RecurrenceFrequency
  dayOfWeek         Int
  startTime         String
  isActive          Boolean             @default(true)
  nextRunDate       DateTime
  createdAt         DateTime            @default(now())

  bookings Booking[]

  @@index([businessId])
}

model Booking {
  id                  String             @id @default(cuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId           String
  service             Service            @relation(fields: [serviceId], references: [id])
  recurringScheduleId String?
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])
  addressLine1        String
  addressLine2        String?
  city                String
  state               String
  latitude            Float?
  longitude           Float?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  status              BookingStatus      @default(REQUESTED)
  quotedPriceCents    Int
  couponId            String?
  coupon              Coupon?            @relation(fields: [couponId], references: [id])
  // Bookkeeping only — CleanSera does not process this payment
  paymentStatus       String             @default("UNPAID") // UNPAID | PAID | PARTIAL
  paymentNote         String?
  cancelReason        String?
  reminderSentAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assignments BookingAssignment[]
  checklist   JobChecklist?
  photos      JobPhoto[]
  review      Review?

  // Prevents the recurring daemon from double-creating a booking for the
  // same schedule + slot if it runs twice (two replicas, a retried tick,
  // etc). recurringScheduleId is null for one-off bookings, and Postgres
  // allows multiple NULLs through a unique index, so this only constrains
  // actual recurring-generated bookings.
  @@unique([recurringScheduleId, scheduledStart])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, scheduledStart])
}

model BookingAssignment {
  id           String         @id @default(cuid())
  bookingId    String
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleanerId    String
  cleaner      CleanerProfile @relation(fields: [cleanerId], references: [id])
  assignedAt   DateTime       @default(now())
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  checkInLat   Float?
  checkInLng   Float?

  @@index([bookingId])
  @@index([cleanerId])
}

// ============================================================
// QUALITY / CHECKLISTS
// ============================================================

model JobChecklist {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items       Json // [{ label, done }]
  completedAt DateTime?
}

model ChecklistTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  items      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model JobPhoto {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stage      String // BEFORE | AFTER
  storageKey String
  uploadedAt DateTime @default(now())

  @@index([bookingId])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Backfilled from the booking's primary assignment at review time. Nullable
  // because a booking can in principle be reviewed with no assignment on
  // record (e.g. data imported from elsewhere) — never block a review over it.
  cleanerId  String?
  cleaner    CleanerProfile? @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([businessId])
  @@index([cleanerId])
}

// ============================================================
// MESSAGING
// ============================================================

model Conversation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subjectType String // CLEANER | CUSTOMER
  subjectId   String // CleanerProfile.id or Customer.id
  createdAt   DateTime @default(now())

  messages Message[]

  @@index([businessId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  body           String?
  attachmentKey  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipientUserId String
  type            String // BOOKING_CONFIRMED | REMINDER | EN_ROUTE | COMPLETED | REVIEW_REQUEST | ...
  title           String
  body            String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([businessId])
  @@index([recipientUserId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id          String    @id @default(cuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

// ============================================================
// CLEANER DOCUMENTS
// ============================================================

enum DocumentType {
  ID_CARD
  BACKGROUND_CHECK
  CERTIFICATION
  CONTRACT
  INSURANCE
  OTHER
}

model CleanerDocument {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cleanerId  String
  cleaner    CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  type       DocumentType   @default(OTHER)
  title      String
  storageKey String
  mimeType   String?
  fileSize   Int?
  expiresAt  DateTime?
  notes      String?
  uploadedBy String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([businessId])
  @@index([cleanerId])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  customerId  String?
  bookingId   String?
  assignedTo  String?
  createdBy   String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages SupportTicketMessage[]

  @@index([businessId])
  @@index([businessId, status])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}
