# Automated TLS for tenant custom domains.
#
# Your existing deploy/ has k8s CronJob and systemd examples, so this
# assumes self-hosted infra, not Vercel — Caddy is the standard way to get
# Let's Encrypt-issued, auto-renewing certificates for an open-ended set of
# customer-supplied domains without provisioning each one by hand.
#
# on_demand_tls issues a certificate the FIRST time a given hostname is
# requested, but only after calling the `ask` endpoint — this is what stops
# a stranger pointing an unrelated domain at your IP from getting you to
# issue (and pay the Let's Encrypt rate-limit cost of) a certificate on
# their behalf. The ask endpoint here is the same public/resolve-domain
# route the frontend middleware uses, so a domain only ever gets a cert
# once it's marked VERIFIED in the database.

{
	on_demand_tls {
		ask https://api.cleansera.nl/api/v1/public/resolve-domain
		interval 2m
		burst 10
	}
}

# The dashboard/app itself — not on-demand, a normal static cert.
app.cleansera.nl {
	reverse_proxy frontend:3000
}

api.cleansera.nl {
	reverse_proxy backend:8000
}

# Shared root domain for subdomain storefronts (acme.cleansera.nl, ...).
*.cleansera.nl {
	tls {
		# Wildcard cert needs a DNS-01 provider, e.g. the Cloudflare or Route53
		# Caddy DNS plugin — this line is provider-specific, fill in yours:
		# dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy frontend:3000
}

# Any other hostname = a candidate tenant custom domain. Caddy calls `ask`
# above before issuing a cert or proxying; unverified hosts get refused
# before ever reaching Let's Encrypt or the frontend.
:443 {
	tls {
		on_demand
	}
	reverse_proxy frontend:3000
}
